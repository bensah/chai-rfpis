# Only VITE_-prefixed variables reach the browser bundle. Never put a Supabase key here.
#
# Production: the deployed Supabase Edge Function. Set this in Cloudflare Pages →
# Settings → Environment variables (it is read at build time).
# VITE_API_BASE=https://<project-ref>.supabase.co/functions/v1/rfpis-api
#
# Local dev: leave unset — the Vite dev server answers /api itself, using the
# Streamlit app's .env in the repo root.
